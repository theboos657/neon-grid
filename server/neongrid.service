# systemd unit for the NEON GRID relay server.
# Copy the repo's neon_shared/ and server/ folders to /opt/neongrid, then:
#   sudo cp server/neongrid.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now neongrid
[Unit]
Description=NEON GRID relay server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/neongrid
ExecStart=/usr/bin/python3 /opt/neongrid/server/relay_server.py --host 0.0.0.0 --port 47777
Restart=always
RestartSec=3
DynamicUser=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes

[Install]
WantedBy=multi-user.target
